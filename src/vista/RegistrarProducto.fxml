<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane id="AnchorPane" fx:id="rootPane" prefHeight="844.0" prefWidth="390.0" stylesheets="@../estilos/estilos.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controlador.RegistrarProductoController">
   <children>
      <ImageView fx:id="imgFlechaAtrasReg" fitHeight="69.0" fitWidth="69.0" layoutX="4.0" layoutY="30.0" onMouseClicked="#onFlechaAtras" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/chevron-left.png" />
         </image>
      </ImageView>
      <Label fx:id="lblTituloRegistrarProd" layoutX="116.0" layoutY="51.0" text="Registrar producto" />
      <ImageView fx:id="imgPreviewProducto" fitHeight="104.0" fitWidth="170.0" layoutX="150.0" layoutY="105.0" pickOnBounds="true" preserveRatio="true" />
      <Button fx:id="btnSeleccionarImagen" layoutX="70.0" layoutY="217.0" mnemonicParsing="false" onAction="#onSeleccionarImagen" prefHeight="42.0" prefWidth="255.0" text="SELECCIONAR IMAGEN" />
      <Label fx:id="lblInfoProductoTitulo" layoutX="38.0" layoutY="282.0" text="Información del producto" />
      <Label fx:id="lblNombreProdTitulo" layoutX="42.0" layoutY="315.0" text="Nombre del producto" />
      <Label fx:id="lblSinImagen" layoutX="176.0" layoutY="147.0" text="Sin imagen" />
      <TextField fx:id="txtNombreProd" layoutX="38.0" layoutY="338.0" prefHeight="33.0" prefWidth="322.0" />
      <TextField fx:id="txtPrecioProd" layoutX="38.0" layoutY="402.0" prefHeight="33.0" prefWidth="322.0" />
      <TextField fx:id="txtStockProd" layoutX="38.0" layoutY="467.0" prefHeight="33.0" prefWidth="322.0" />
      <Button fx:id="btnRegistrarProductoAdmin" layoutX="80.0" layoutY="740.0" mnemonicParsing="false" onAction="#onRegistrarProducto" prefHeight="37.0" prefWidth="255.0" text="REGISTRAR PRODUCTO" />
      <Button fx:id="btnCancelarRegProd" layoutX="81.0" layoutY="785.0" mnemonicParsing="false" onAction="#onCancelar" prefHeight="37.0" prefWidth="255.0" text="CANCELAR" />
      <Label fx:id="lblPrecioProdTitulo" layoutX="42.0" layoutY="378.0" text="Precio" />
      <Label fx:id="lblStockProdTitulo" layoutX="41.0" layoutY="442.0" text="Stock" />
      <Label fx:id="lblCategoriaProdTitulo" layoutX="42.0" layoutY="509.0" text="Categoría" />
      <Label fx:id="lblDescripcionProdTitulo" layoutX="44.0" layoutY="575.0" text="Descripción" />
      <ComboBox fx:id="cmbCategoriaProd" layoutX="36.0" layoutY="534.0" prefHeight="31.0" prefWidth="322.0" promptText="Seleccione categoría" />
      <TextArea fx:id="txtDescripcionProd" layoutX="38.0" layoutY="597.0" prefHeight="133.0" prefWidth="322.0" />
   </children>
</AnchorPane>
